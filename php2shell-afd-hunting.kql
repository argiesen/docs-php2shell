// PHP2Shell hunting: Azure Front Door. Each block below is self-contained.
// Click anywhere inside a block and select Run; Log Analytics runs only the block
// at the cursor (blocks are separated by blank lines).

// -----------------------------------------------------------------------------
// Q1. Known PHP2Shell tooling: scanner/PoC user agents, probe paths, early
//     source IPs. IPs and UAs change easily; treat hits as confirmed, misses as
//     inconclusive.
// -----------------------------------------------------------------------------
let lookback = 14d;
let AfdAccess = AzureDiagnostics
    | where TimeGenerated > ago(lookback)
    | where Category in~ ("FrontDoorAccessLog")
    | extend Uri = tostring(column_ifexists("requestUri_s", ""))
    | extend
        ClientIp  = tostring(column_ifexists("clientIp_s", "")),
        Host      = coalesce(tostring(column_ifexists("hostName_s", "")), tostring(parse_url(Uri).Host)),
        Path      = tostring(parse_url(Uri).Path),
        Query     = extract(@"\?([^#]*)", 1, Uri),
        Method    = toupper(tostring(column_ifexists("httpMethod_s", ""))),
        UA        = tostring(column_ifexists("userAgent_s", "")),
        Status    = toint(coalesce(tostring(column_ifexists("httpStatusCode_s", "")), tostring(column_ifexists("httpStatusCode_d", real(null))))),
        ReqBytes  = tolong(coalesce(tostring(column_ifexists("requestBytes_s", "")), tostring(column_ifexists("requestBytes_d", real(null))))),
        TimeTaken = todouble(coalesce(tostring(column_ifexists("timeTaken_s", "")), tostring(column_ifexists("timeTaken_d", real(null))))),
        Origin    = tostring(column_ifexists("originName_s", "")),
        Ref       = tostring(column_ifexists("trackingReference_s", ""));
let AfdWaf = AzureDiagnostics
    | where TimeGenerated > ago(lookback)
    | where Category in~ ("FrontDoorWebApplicationFirewallLog")
    | extend
        ClientIp = tostring(column_ifexists("clientIP_s", "")),
        Host     = tostring(column_ifexists("host_s", "")),
        Uri      = tostring(column_ifexists("requestUri_s", "")),
        Rule     = tostring(column_ifexists("ruleName_s", "")),
        Action   = tostring(column_ifexists("action_s", "")),
        Mode     = tostring(column_ifexists("policyMode_s", "")),
        Policy   = tostring(column_ifexists("policy_s", "")),
        Ref      = tostring(column_ifexists("trackingReference_s", "")),
        Details  = strcat(tostring(column_ifexists("details_matches_s", "")), " ",
                          tostring(column_ifexists("details_msg_s", "")), " ",
                          tostring(column_ifexists("details_data_s", "")));
let IocIps = dynamic(["109.71.252.97", "221.14.159.134", "45.198.224.169"]);
AfdAccess
| where UA contains "php2shell" or Path contains "php2shell" or ClientIp in (IocIps)
| summarize Requests = count(), First = min(TimeGenerated), Last = max(TimeGenerated),
            Hosts = make_set(Host, 25), Statuses = make_set(Status), Paths = make_set(Path, 25),
            UAs = make_set(UA, 5)
    by ClientIp
| order by Requests desc

// -----------------------------------------------------------------------------
// Q2. WAF matches on exploit content: the upload-progress field, the PoC web
//     shell marker, or PoC multipart boundaries. Joined to the access log to show
//     whether the request reached the origin and what it returned.
// -----------------------------------------------------------------------------
let lookback = 14d;
let AfdAccess = AzureDiagnostics
    | where TimeGenerated > ago(lookback)
    | where Category in~ ("FrontDoorAccessLog")
    | extend Uri = tostring(column_ifexists("requestUri_s", ""))
    | extend
        ClientIp  = tostring(column_ifexists("clientIp_s", "")),
        Host      = coalesce(tostring(column_ifexists("hostName_s", "")), tostring(parse_url(Uri).Host)),
        Path      = tostring(parse_url(Uri).Path),
        Query     = extract(@"\?([^#]*)", 1, Uri),
        Method    = toupper(tostring(column_ifexists("httpMethod_s", ""))),
        UA        = tostring(column_ifexists("userAgent_s", "")),
        Status    = toint(coalesce(tostring(column_ifexists("httpStatusCode_s", "")), tostring(column_ifexists("httpStatusCode_d", real(null))))),
        ReqBytes  = tolong(coalesce(tostring(column_ifexists("requestBytes_s", "")), tostring(column_ifexists("requestBytes_d", real(null))))),
        TimeTaken = todouble(coalesce(tostring(column_ifexists("timeTaken_s", "")), tostring(column_ifexists("timeTaken_d", real(null))))),
        Origin    = tostring(column_ifexists("originName_s", "")),
        Ref       = tostring(column_ifexists("trackingReference_s", ""));
let AfdWaf = AzureDiagnostics
    | where TimeGenerated > ago(lookback)
    | where Category in~ ("FrontDoorWebApplicationFirewallLog")
    | extend
        ClientIp = tostring(column_ifexists("clientIP_s", "")),
        Host     = tostring(column_ifexists("host_s", "")),
        Uri      = tostring(column_ifexists("requestUri_s", "")),
        Rule     = tostring(column_ifexists("ruleName_s", "")),
        Action   = tostring(column_ifexists("action_s", "")),
        Mode     = tostring(column_ifexists("policyMode_s", "")),
        Policy   = tostring(column_ifexists("policy_s", "")),
        Ref      = tostring(column_ifexists("trackingReference_s", "")),
        Details  = strcat(tostring(column_ifexists("details_matches_s", "")), " ",
                          tostring(column_ifexists("details_msg_s", "")), " ",
                          tostring(column_ifexists("details_data_s", "")));
AfdWaf
| where Details contains "PHP_SESSION_UPLOAD_PROGRESS"
     or Details contains "PWNED::"
     or Details contains "----p2s"
     or Uri contains "php2shell"
| join kind=leftouter (AfdAccess | project Ref, OriginStatus = Status, UA, Origin) on Ref
| project TimeGenerated, ClientIp, Host, Uri, Rule, Action, Mode, Policy, OriginStatus, Origin, UA, Details
| order by TimeGenerated asc

// -----------------------------------------------------------------------------
// Q3. CVE-2026-109618 "arm then fire" shape: a large POST that returns 500,
//     followed within 10 minutes by a POST returning 502/503/504 from the same
//     client to the same host. Tune ArmMinBytes for your apps.
// -----------------------------------------------------------------------------
let lookback = 14d;
let AfdAccess = AzureDiagnostics
    | where TimeGenerated > ago(lookback)
    | where Category in~ ("FrontDoorAccessLog")
    | extend Uri = tostring(column_ifexists("requestUri_s", ""))
    | extend
        ClientIp  = tostring(column_ifexists("clientIp_s", "")),
        Host      = coalesce(tostring(column_ifexists("hostName_s", "")), tostring(parse_url(Uri).Host)),
        Path      = tostring(parse_url(Uri).Path),
        Query     = extract(@"\?([^#]*)", 1, Uri),
        Method    = toupper(tostring(column_ifexists("httpMethod_s", ""))),
        UA        = tostring(column_ifexists("userAgent_s", "")),
        Status    = toint(coalesce(tostring(column_ifexists("httpStatusCode_s", "")), tostring(column_ifexists("httpStatusCode_d", real(null))))),
        ReqBytes  = tolong(coalesce(tostring(column_ifexists("requestBytes_s", "")), tostring(column_ifexists("requestBytes_d", real(null))))),
        TimeTaken = todouble(coalesce(tostring(column_ifexists("timeTaken_s", "")), tostring(column_ifexists("timeTaken_d", real(null))))),
        Origin    = tostring(column_ifexists("originName_s", "")),
        Ref       = tostring(column_ifexists("trackingReference_s", ""));
let AfdWaf = AzureDiagnostics
    | where TimeGenerated > ago(lookback)
    | where Category in~ ("FrontDoorWebApplicationFirewallLog")
    | extend
        ClientIp = tostring(column_ifexists("clientIP_s", "")),
        Host     = tostring(column_ifexists("host_s", "")),
        Uri      = tostring(column_ifexists("requestUri_s", "")),
        Rule     = tostring(column_ifexists("ruleName_s", "")),
        Action   = tostring(column_ifexists("action_s", "")),
        Mode     = tostring(column_ifexists("policyMode_s", "")),
        Policy   = tostring(column_ifexists("policy_s", "")),
        Ref      = tostring(column_ifexists("trackingReference_s", "")),
        Details  = strcat(tostring(column_ifexists("details_matches_s", "")), " ",
                          tostring(column_ifexists("details_msg_s", "")), " ",
                          tostring(column_ifexists("details_data_s", "")));
let ArmMinBytes = 262144;   // 256 KB
let Arms = AfdAccess
    | where Method == "POST" and ReqBytes >= ArmMinBytes and Status == 500
    | project ArmTime = TimeGenerated, ClientIp, Host, ArmPath = Path, ArmBytes = ReqBytes;
let Fires = AfdAccess
    | where Method == "POST" and Status in (502, 503, 504)
    | project FireTime = TimeGenerated, ClientIp, Host, FireStatus = Status;
Arms
| join kind=inner Fires on ClientIp, Host
| where FireTime between (ArmTime .. (ArmTime + 10m))
| summarize ArmCount = dcount(ArmTime), FireCount = count(), FirstArm = min(ArmTime),
            LastFire = max(FireTime), MaxArmKB = max(ArmBytes) / 1024, Paths = make_set(ArmPath, 10)
    by ClientIp, Host
| order by FireCount desc

// -----------------------------------------------------------------------------
// Q4. Amplification bursts: more than 3 large POSTs from one client to one host
//     inside 2 minutes. Reported attack traffic used bodies of a few hundred KB.
// -----------------------------------------------------------------------------
let lookback = 14d;
let AfdAccess = AzureDiagnostics
    | where TimeGenerated > ago(lookback)
    | where Category in~ ("FrontDoorAccessLog")
    | extend Uri = tostring(column_ifexists("requestUri_s", ""))
    | extend
        ClientIp  = tostring(column_ifexists("clientIp_s", "")),
        Host      = coalesce(tostring(column_ifexists("hostName_s", "")), tostring(parse_url(Uri).Host)),
        Path      = tostring(parse_url(Uri).Path),
        Query     = extract(@"\?([^#]*)", 1, Uri),
        Method    = toupper(tostring(column_ifexists("httpMethod_s", ""))),
        UA        = tostring(column_ifexists("userAgent_s", "")),
        Status    = toint(coalesce(tostring(column_ifexists("httpStatusCode_s", "")), tostring(column_ifexists("httpStatusCode_d", real(null))))),
        ReqBytes  = tolong(coalesce(tostring(column_ifexists("requestBytes_s", "")), tostring(column_ifexists("requestBytes_d", real(null))))),
        TimeTaken = todouble(coalesce(tostring(column_ifexists("timeTaken_s", "")), tostring(column_ifexists("timeTaken_d", real(null))))),
        Origin    = tostring(column_ifexists("originName_s", "")),
        Ref       = tostring(column_ifexists("trackingReference_s", ""));
let AfdWaf = AzureDiagnostics
    | where TimeGenerated > ago(lookback)
    | where Category in~ ("FrontDoorWebApplicationFirewallLog")
    | extend
        ClientIp = tostring(column_ifexists("clientIP_s", "")),
        Host     = tostring(column_ifexists("host_s", "")),
        Uri      = tostring(column_ifexists("requestUri_s", "")),
        Rule     = tostring(column_ifexists("ruleName_s", "")),
        Action   = tostring(column_ifexists("action_s", "")),
        Mode     = tostring(column_ifexists("policyMode_s", "")),
        Policy   = tostring(column_ifexists("policy_s", "")),
        Ref      = tostring(column_ifexists("trackingReference_s", "")),
        Details  = strcat(tostring(column_ifexists("details_matches_s", "")), " ",
                          tostring(column_ifexists("details_msg_s", "")), " ",
                          tostring(column_ifexists("details_data_s", "")));
AfdAccess
| where Method == "POST" and ReqBytes >= 102400   // 100 KB
| summarize Posts = count(), Errors5xx = countif(Status >= 500), AvgKB = avg(ReqBytes) / 1024
    by ClientIp, Host, Window = bin(TimeGenerated, 2m)
| where Posts > 3
| summarize BurstWindows = count(), TotalPosts = sum(Posts), Total5xx = sum(Errors5xx),
            AvgKB = round(avg(AvgKB), 0), First = min(Window), Last = max(Window)
    by ClientIp, Host
| order by Total5xx desc, TotalPosts desc

// -----------------------------------------------------------------------------
// Q5. POST 5xx trend per host. Look for hosts that spike from October 21, 2026
//     onward without a matching deployment or outage.
// -----------------------------------------------------------------------------
let lookback = 14d;
let AfdAccess = AzureDiagnostics
    | where TimeGenerated > ago(lookback)
    | where Category in~ ("FrontDoorAccessLog")
    | extend Uri = tostring(column_ifexists("requestUri_s", ""))
    | extend
        ClientIp  = tostring(column_ifexists("clientIp_s", "")),
        Host      = coalesce(tostring(column_ifexists("hostName_s", "")), tostring(parse_url(Uri).Host)),
        Path      = tostring(parse_url(Uri).Path),
        Query     = extract(@"\?([^#]*)", 1, Uri),
        Method    = toupper(tostring(column_ifexists("httpMethod_s", ""))),
        UA        = tostring(column_ifexists("userAgent_s", "")),
        Status    = toint(coalesce(tostring(column_ifexists("httpStatusCode_s", "")), tostring(column_ifexists("httpStatusCode_d", real(null))))),
        ReqBytes  = tolong(coalesce(tostring(column_ifexists("requestBytes_s", "")), tostring(column_ifexists("requestBytes_d", real(null))))),
        TimeTaken = todouble(coalesce(tostring(column_ifexists("timeTaken_s", "")), tostring(column_ifexists("timeTaken_d", real(null))))),
        Origin    = tostring(column_ifexists("originName_s", "")),
        Ref       = tostring(column_ifexists("trackingReference_s", ""));
let AfdWaf = AzureDiagnostics
    | where TimeGenerated > ago(lookback)
    | where Category in~ ("FrontDoorWebApplicationFirewallLog")
    | extend
        ClientIp = tostring(column_ifexists("clientIP_s", "")),
        Host     = tostring(column_ifexists("host_s", "")),
        Uri      = tostring(column_ifexists("requestUri_s", "")),
        Rule     = tostring(column_ifexists("ruleName_s", "")),
        Action   = tostring(column_ifexists("action_s", "")),
        Mode     = tostring(column_ifexists("policyMode_s", "")),
        Policy   = tostring(column_ifexists("policy_s", "")),
        Ref      = tostring(column_ifexists("trackingReference_s", "")),
        Details  = strcat(tostring(column_ifexists("details_matches_s", "")), " ",
                          tostring(column_ifexists("details_msg_s", "")), " ",
                          tostring(column_ifexists("details_data_s", "")));
AfdAccess
| where Method == "POST" and Status >= 500
| summarize Errors = count() by Host, bin(TimeGenerated, 1h)
| render timechart

// -----------------------------------------------------------------------------
// Q6. Possible web shell use: requests to .php paths with a command-style query
//     parameter (the published PoC shell reads $_GET['c']).
// -----------------------------------------------------------------------------
let lookback = 14d;
let AfdAccess = AzureDiagnostics
    | where TimeGenerated > ago(lookback)
    | where Category in~ ("FrontDoorAccessLog")
    | extend Uri = tostring(column_ifexists("requestUri_s", ""))
    | extend
        ClientIp  = tostring(column_ifexists("clientIp_s", "")),
        Host      = coalesce(tostring(column_ifexists("hostName_s", "")), tostring(parse_url(Uri).Host)),
        Path      = tostring(parse_url(Uri).Path),
        Query     = extract(@"\?([^#]*)", 1, Uri),
        Method    = toupper(tostring(column_ifexists("httpMethod_s", ""))),
        UA        = tostring(column_ifexists("userAgent_s", "")),
        Status    = toint(coalesce(tostring(column_ifexists("httpStatusCode_s", "")), tostring(column_ifexists("httpStatusCode_d", real(null))))),
        ReqBytes  = tolong(coalesce(tostring(column_ifexists("requestBytes_s", "")), tostring(column_ifexists("requestBytes_d", real(null))))),
        TimeTaken = todouble(coalesce(tostring(column_ifexists("timeTaken_s", "")), tostring(column_ifexists("timeTaken_d", real(null))))),
        Origin    = tostring(column_ifexists("originName_s", "")),
        Ref       = tostring(column_ifexists("trackingReference_s", ""));
let AfdWaf = AzureDiagnostics
    | where TimeGenerated > ago(lookback)
    | where Category in~ ("FrontDoorWebApplicationFirewallLog")
    | extend
        ClientIp = tostring(column_ifexists("clientIP_s", "")),
        Host     = tostring(column_ifexists("host_s", "")),
        Uri      = tostring(column_ifexists("requestUri_s", "")),
        Rule     = tostring(column_ifexists("ruleName_s", "")),
        Action   = tostring(column_ifexists("action_s", "")),
        Mode     = tostring(column_ifexists("policyMode_s", "")),
        Policy   = tostring(column_ifexists("policy_s", "")),
        Ref      = tostring(column_ifexists("trackingReference_s", "")),
        Details  = strcat(tostring(column_ifexists("details_matches_s", "")), " ",
                          tostring(column_ifexists("details_msg_s", "")), " ",
                          tostring(column_ifexists("details_data_s", "")));
AfdAccess
| where Path endswith ".php" and isnotempty(Query)
| extend Decoded = url_decode(Query)
| where Decoded matches regex @"(?i)(^|&)(c|cmd|exec|command)="
     or Decoded has_any ("whoami", "uname", "/etc/passwd", "base64", "bash -c", "sh -c", "wget", "curl")
| project TimeGenerated, ClientIp, Host, Path, Decoded, Status, UA, Origin
| order by TimeGenerated asc

// -----------------------------------------------------------------------------
// Q7. Recon: phpinfo-style probes. Many hosts from one source is scanning; any
//     200 response is an exposed phpinfo page worth removing regardless.
// -----------------------------------------------------------------------------
let lookback = 14d;
let AfdAccess = AzureDiagnostics
    | where TimeGenerated > ago(lookback)
    | where Category in~ ("FrontDoorAccessLog")
    | extend Uri = tostring(column_ifexists("requestUri_s", ""))
    | extend
        ClientIp  = tostring(column_ifexists("clientIp_s", "")),
        Host      = coalesce(tostring(column_ifexists("hostName_s", "")), tostring(parse_url(Uri).Host)),
        Path      = tostring(parse_url(Uri).Path),
        Query     = extract(@"\?([^#]*)", 1, Uri),
        Method    = toupper(tostring(column_ifexists("httpMethod_s", ""))),
        UA        = tostring(column_ifexists("userAgent_s", "")),
        Status    = toint(coalesce(tostring(column_ifexists("httpStatusCode_s", "")), tostring(column_ifexists("httpStatusCode_d", real(null))))),
        ReqBytes  = tolong(coalesce(tostring(column_ifexists("requestBytes_s", "")), tostring(column_ifexists("requestBytes_d", real(null))))),
        TimeTaken = todouble(coalesce(tostring(column_ifexists("timeTaken_s", "")), tostring(column_ifexists("timeTaken_d", real(null))))),
        Origin    = tostring(column_ifexists("originName_s", "")),
        Ref       = tostring(column_ifexists("trackingReference_s", ""));
let AfdWaf = AzureDiagnostics
    | where TimeGenerated > ago(lookback)
    | where Category in~ ("FrontDoorWebApplicationFirewallLog")
    | extend
        ClientIp = tostring(column_ifexists("clientIP_s", "")),
        Host     = tostring(column_ifexists("host_s", "")),
        Uri      = tostring(column_ifexists("requestUri_s", "")),
        Rule     = tostring(column_ifexists("ruleName_s", "")),
        Action   = tostring(column_ifexists("action_s", "")),
        Mode     = tostring(column_ifexists("policyMode_s", "")),
        Policy   = tostring(column_ifexists("policy_s", "")),
        Ref      = tostring(column_ifexists("trackingReference_s", "")),
        Details  = strcat(tostring(column_ifexists("details_matches_s", "")), " ",
                          tostring(column_ifexists("details_msg_s", "")), " ",
                          tostring(column_ifexists("details_data_s", "")));
let InfoPages = dynamic(["/phpinfo.php", "/info.php", "/php.php", "/pi.php", "/test.php", "/i.php"]);
AfdAccess
| where tolower(Path) in (InfoPages) or tolower(Path) startswith "/php2shell-probe"
| summarize Hosts = dcount(Host), Requests = count(), Hits200 = countif(Status == 200),
            HostsWith200 = make_set_if(Host, Status == 200, 25), First = min(TimeGenerated)
    by ClientIp, UA
| where Hosts >= 3 or Hits200 > 0
| order by Hits200 desc, Hosts desc

// -----------------------------------------------------------------------------
// Q8. Pivot: full timeline for suspect IPs from Q1-Q7 across access and WAF logs.
// -----------------------------------------------------------------------------
let lookback = 14d;
let AfdAccess = AzureDiagnostics
    | where TimeGenerated > ago(lookback)
    | where Category in~ ("FrontDoorAccessLog")
    | extend Uri = tostring(column_ifexists("requestUri_s", ""))
    | extend
        ClientIp  = tostring(column_ifexists("clientIp_s", "")),
        Host      = coalesce(tostring(column_ifexists("hostName_s", "")), tostring(parse_url(Uri).Host)),
        Path      = tostring(parse_url(Uri).Path),
        Query     = extract(@"\?([^#]*)", 1, Uri),
        Method    = toupper(tostring(column_ifexists("httpMethod_s", ""))),
        UA        = tostring(column_ifexists("userAgent_s", "")),
        Status    = toint(coalesce(tostring(column_ifexists("httpStatusCode_s", "")), tostring(column_ifexists("httpStatusCode_d", real(null))))),
        ReqBytes  = tolong(coalesce(tostring(column_ifexists("requestBytes_s", "")), tostring(column_ifexists("requestBytes_d", real(null))))),
        TimeTaken = todouble(coalesce(tostring(column_ifexists("timeTaken_s", "")), tostring(column_ifexists("timeTaken_d", real(null))))),
        Origin    = tostring(column_ifexists("originName_s", "")),
        Ref       = tostring(column_ifexists("trackingReference_s", ""));
let AfdWaf = AzureDiagnostics
    | where TimeGenerated > ago(lookback)
    | where Category in~ ("FrontDoorWebApplicationFirewallLog")
    | extend
        ClientIp = tostring(column_ifexists("clientIP_s", "")),
        Host     = tostring(column_ifexists("host_s", "")),
        Uri      = tostring(column_ifexists("requestUri_s", "")),
        Rule     = tostring(column_ifexists("ruleName_s", "")),
        Action   = tostring(column_ifexists("action_s", "")),
        Mode     = tostring(column_ifexists("policyMode_s", "")),
        Policy   = tostring(column_ifexists("policy_s", "")),
        Ref      = tostring(column_ifexists("trackingReference_s", "")),
        Details  = strcat(tostring(column_ifexists("details_matches_s", "")), " ",
                          tostring(column_ifexists("details_msg_s", "")), " ",
                          tostring(column_ifexists("details_data_s", "")));
let Suspects = dynamic(["203.0.113.10"]);   // replace
union
    (AfdAccess | where ClientIp in (Suspects)
        | project TimeGenerated, Source = "Access", ClientIp, Host, Method, Path, Status, ReqBytes, UA, Ref),
    (AfdWaf | where ClientIp in (Suspects)
        | project TimeGenerated, Source = "WAF", ClientIp, Host, Path = Uri, Rule, Action, Ref)
| order by TimeGenerated asc

// =============================================================================
// Origin bypass check (App Service logs). Traffic that reaches App Service
// directly never appears in Front Door logs. Requires the AppServiceHTTPLogs
// diagnostic category.
// =============================================================================
AppServiceHTTPLogs
| where TimeGenerated > ago(14d)
| where UserAgent contains "php2shell"
     or CsUriStem contains "php2shell"
     or (CsMethod == "POST" and CsBytes >= 262144 and ScStatus in (500, 502, 503))
| summarize Requests = count(), Statuses = make_set(ScStatus), First = min(TimeGenerated),
            Last = max(TimeGenerated), Paths = make_set(CsUriStem, 10)
    by CIp, CsHost, UserAgent, _ResourceId
| order by Requests desc
