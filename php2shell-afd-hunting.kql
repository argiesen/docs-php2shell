        Status    = toint(coalesce(tostring(column_ifexists("httpStatusCode_s", "")), tostring(column_ifexists("httpStatusCode_d", real(null))))),
        ReqBytes  = tolong(coalesce(tostring(column_ifexists("requestBytes_s", "")), tostring(column_ifexists("requestBytes_d", real(null))))),
        TimeTaken = todouble(coalesce(tostring(column_ifexists("timeTaken_s", "")), tostring(column_ifexists("timeTaken_d", real(null))))),
        Origin    = tostring(column_ifexists("originName_s", "")),
