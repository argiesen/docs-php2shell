let AfdWaf = AzureDiagnostics
    | where TimeGenerated > ago(lookback)
    | where Category in~ ("FrontDoorWebApplicationFirewallLog")
    | extend
        ClientIp = tostring(column_ifexists("clientIP_s", "")),
        Host     = tostring(column_ifexists("host_s", "")),
        Uri      = tostring(column_ifexists("requestUri_s", "")),
        Rule     = tostring(column_ifexists("ruleName_s", "")),
        Action   = tostring(column_ifexists("action_s", "")),
        Mode     = tostring(column_ifexists("policyMode_s", "")),
        Policy   = tostring(column_ifexists("policy_s", "")),
        Ref      = tostring(column_ifexists("trackingReference_s", "")),
        Details  = strcat(tostring(column_ifexists("details_matches_s", "")), " ",
                          tostring(column_ifexists("details_msg_s", "")), " ",
                          tostring(column_ifexists("details_data_s", "")));
AfdAccess
| where Method == "POST" and Status >= 500
| summarize Errors = count() by Host, bin(TimeGenerated, 1h)
| render timechart

// -----------------------------------------------------------------------------
// Q6. Possible web shell use: requests to .php paths with a command-style query
//     parameter (the published PoC shell reads $_GET['c']).
// -----------------------------------------------------------------------------
let lookback = now() - datetime(2026-10-15);   // earliest known exploitation: 2026-10-17
let AfdAccess = AzureDiagnostics
    | where TimeGenerated > ago(lookback)
    | where Category in~ ("FrontDoorAccessLog")
    | extend Uri = tostring(column_ifexists("requestUri_s", ""))
    | extend
        ClientIp  = tostring(column_ifexists("clientIp_s", "")),
        Host      = coalesce(tostring(column_ifexists("hostName_s", "")), tostring(parse_url(Uri).Host)),
        Path      = tostring(parse_url(Uri).Path),
        Query     = extract(@"\?([^#]*)", 1, Uri),
        Method    = toupper(tostring(column_ifexists("httpMethod_s", ""))),
        UA        = tostring(column_ifexists("userAgent_s", "")),
        Status    = toint(coalesce(tostring(column_ifexists("httpStatusCode_s", "")), tostring(column_ifexists("httpStatusCode_d", real(null))))),
        ReqBytes  = tolong(coalesce(tostring(column_ifexists("requestBytes_s", "")), tostring(column_ifexists("requestBytes_d", real(null))))),
        TimeTaken = todouble(coalesce(tostring(column_ifexists("timeTaken_s", "")), tostring(column_ifexists("timeTaken_d", real(null))))),
        Origin    = tostring(column_ifexists("originName_s", "")),
        Ref       = tostring(column_ifexists("trackingReference_s", ""));
let AfdWaf = AzureDiagnostics
    | where TimeGenerated > ago(lookback)
    | where Category in~ ("FrontDoorWebApplicationFirewallLog")
    | extend
        ClientIp = tostring(column_ifexists("clientIP_s", "")),
        Host     = tostring(column_ifexists("host_s", "")),
        Uri      = tostring(column_ifexists("requestUri_s", "")),
        Rule     = tostring(column_ifexists("ruleName_s", "")),
        Action   = tostring(column_ifexists("action_s", "")),
        Mode     = tostring(column_ifexists("policyMode_s", "")),
        Policy   = tostring(column_ifexists("policy_s", "")),
        Ref      = tostring(column_ifexists("trackingReference_s", "")),
        Details  = strcat(tostring(column_ifexists("details_matches_s", "")), " ",
                          tostring(column_ifexists("details_msg_s", "")), " ",
                          tostring(column_ifexists("details_data_s", "")));
AfdAccess
| where Path endswith ".php" and isnotempty(Query)
| extend Decoded = url_decode(Query)
| where Decoded matches regex @"(?i)(^|&)(c|cmd|exec|command)="
     or Decoded has_any ("whoami", "uname", "/etc/passwd", "base64", "bash -c", "sh -c", "wget", "curl")
| project TimeGenerated, ClientIp, Host, Path, Decoded, Status, UA, Origin
| order by TimeGenerated asc

// -----------------------------------------------------------------------------
// Q7. Recon: phpinfo-style probes. Many hosts from one source is scanning; any
//     200 response is an exposed phpinfo page worth removing regardless.
// -----------------------------------------------------------------------------
let lookback = now() - datetime(2026-10-15);   // earliest known exploitation: 2026-10-17
let AfdAccess = AzureDiagnostics
    | where TimeGenerated > ago(lookback)
    | where Category in~ ("FrontDoorAccessLog")
    | extend Uri = tostring(column_ifexists("requestUri_s", ""))
    | extend
        ClientIp  = tostring(column_ifexists("clientIp_s", "")),
        Host      = coalesce(tostring(column_ifexists("hostName_s", "")), tostring(parse_url(Uri).Host)),
        Path      = tostring(parse_url(Uri).Path),
        Query     = extract(@"\?([^#]*)", 1, Uri),
        Method    = toupper(tostring(column_ifexists("httpMethod_s", ""))),
        UA        = tostring(column_ifexists("userAgent_s", "")),
        Status    = toint(coalesce(tostring(column_ifexists("httpStatusCode_s", "")), tostring(column_ifexists("httpStatusCode_d", real(null))))),
        ReqBytes  = tolong(coalesce(tostring(column_ifexists("requestBytes_s", "")), tostring(column_ifexists("requestBytes_d", real(null))))),
        TimeTaken = todouble(coalesce(tostring(column_ifexists("timeTaken_s", "")), tostring(column_ifexists("timeTaken_d", real(null))))),
        Origin    = tostring(column_ifexists("originName_s", "")),
        Ref       = tostring(column_ifexists("trackingReference_s", ""));
let AfdWaf = AzureDiagnostics
    | where TimeGenerated > ago(lookback)
    | where Category in~ ("FrontDoorWebApplicationFirewallLog")
    | extend
        ClientIp = tostring(column_ifexists("clientIP_s", "")),
        Host     = tostring(column_ifexists("host_s", "")),
        Uri      = tostring(column_ifexists("requestUri_s", "")),
        Rule     = tostring(column_ifexists("ruleName_s", "")),
        Action   = tostring(column_ifexists("action_s", "")),
        Mode     = tostring(column_ifexists("policyMode_s", "")),
        Policy   = tostring(column_ifexists("policy_s", "")),
        Ref      = tostring(column_ifexists("trackingReference_s", "")),
        Details  = strcat(tostring(column_ifexists("details_matches_s", "")), " ",
                          tostring(column_ifexists("details_msg_s", "")), " ",
                          tostring(column_ifexists("details_data_s", "")));
let InfoPages = dynamic(["/phpinfo.php", "/info.php", "/php.php", "/pi.php", "/test.php", "/i.php"]);
AfdAccess
| where tolower(Path) in (InfoPages) or tolower(Path) startswith "/php2shell-probe"
| summarize Hosts = dcount(Host), Requests = count(), Hits200 = countif(Status == 200),
            HostsWith200 = make_set_if(Host, Status == 200, 25), First = min(TimeGenerated)
    by ClientIp, UA
| where Hosts >= 3 or Hits200 > 0
| order by Hits200 desc, Hosts desc

// -----------------------------------------------------------------------------
// Q8. CVE-2026-109619 heap grooming: many small POSTs from one client to "/" or
//     "/index.php" in a short window. F5 reports this as the most common pattern
//     (fresh PHPSESSID and multipart boundary per request, generic Mozilla UA).
//     Tune MinPosts for hosts that take legitimate form posts at the root.
// -----------------------------------------------------------------------------
let lookback = now() - datetime(2026-10-15);   // earliest known exploitation: 2026-10-17
let AfdAccess = AzureDiagnostics
    | where TimeGenerated > ago(lookback)
    | where Category in~ ("FrontDoorAccessLog")
    | extend Uri = tostring(column_ifexists("requestUri_s", ""))
    | extend
        ClientIp  = tostring(column_ifexists("clientIp_s", "")),
        Host      = coalesce(tostring(column_ifexists("hostName_s", "")), tostring(parse_url(Uri).Host)),
        Path      = tostring(parse_url(Uri).Path),
        Query     = extract(@"\?([^#]*)", 1, Uri),
        Method    = toupper(tostring(column_ifexists("httpMethod_s", ""))),
        UA        = tostring(column_ifexists("userAgent_s", "")),
        Status    = toint(coalesce(tostring(column_ifexists("httpStatusCode_s", "")), tostring(column_ifexists("httpStatusCode_d", real(null))))),
        ReqBytes  = tolong(coalesce(tostring(column_ifexists("requestBytes_s", "")), tostring(column_ifexists("requestBytes_d", real(null))))),
        TimeTaken = todouble(coalesce(tostring(column_ifexists("timeTaken_s", "")), tostring(column_ifexists("timeTaken_d", real(null))))),
        Origin    = tostring(column_ifexists("originName_s", "")),
        Ref       = tostring(column_ifexists("trackingReference_s", ""));
let MinPosts = 20;
AfdAccess
| where Method == "POST" and Path in ("/", "/index.php") and ReqBytes < 8192
| summarize Posts = count() by ClientIp, Host, Window = bin(TimeGenerated, 10m)
| where Posts >= MinPosts
| summarize Windows = count(), TotalPosts = sum(Posts), First = min(Window), Last = max(Window)
    by ClientIp, Host
| order by TotalPosts desc

// -----------------------------------------------------------------------------
// Q9. Pivot: full timeline for suspect IPs from Q1-Q8 across access and WAF logs.
